{
  "expo": {
    "name": "ZeroQApp",
    "slug": "ZeroQApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-camera",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "ed248872-f5fe-4763-8e13-2858a4e5a2c2"
      }
    },
    "android": {
      "package": "com.pulkitgoenka.ZeroQApp",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ed248872-f5fe-4763-8e13-2858a4e5a2c2",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}