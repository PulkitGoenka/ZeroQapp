{
  "expo": {
    "name": "ITS3LF",
    "slug": "its3lf",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-camera",
      "expo-font",
      "expo-status-bar"
    ],
    "android": {
      "package": "com.its3lf.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "62fb132a-9cdc-4aba-aa77-792569e987bd"
      }
    },
    "owner": "samradh1718"
  }
}
